  "items": [
    {
      "id": "S01",
      "level": "简单",
      "question": "这个灯塔展馆图谱收录了多少个微服务节点？返回数量。",
      "reference_cypher": "MATCH (s:微服务) RETURN count(s) AS 数量",
      "columns": [
        {
          "name": "数量",
          "aliases": [
            "count",
            "total",
            "节点数",
            "总数"
          ]
        }
      ],
      "expected_rows": [
        {
          "数量": 8
        }
      ]
    },
    {
      "id": "S02",
      "level": "简单",
      "question": "在本图中，ts-lantern-gallery-service 的节点 ID 是多少？只返回节点ID。",
      "reference_cypher": "MATCH (s:微服务) WHERE s.服务名称='ts-lantern-gallery-service' RETURN s.nodeId AS 节点ID",
      "columns": [
        {
          "name": "节点ID",
          "aliases": [
            "nodeId",
            "node_id",
            "id",
            "服务ID"
          ]
        }
      ],
      "expected_rows": [
        {
          "节点ID": "svc:ts-lantern-gallery-service"
        }
      ]
    },
    {
      "id": "S03",
      "level": "简单",
      "question": "简单类名 ShowCoordinator 的 Java 类全名是什么？返回全限定名。",
      "reference_cypher": "MATCH (c:类) WHERE c.简单名='ShowCoordinator' RETURN c.全限定名 AS 全限定名",
      "columns": [
        {
          "name": "全限定名",
          "aliases": [
            "qualifiedName",
            "full_name",
            "方法全限定名",
            "类全限定名"
          ]
        }
      ],
      "expected_rows": [
        {
          "全限定名": "lantern.gallery.ShowCoordinator"
        }
      ]
    },
    {
      "id": "S04",
      "level": "简单",
      "question": "列出数据库中所有消息队列的名称，结果列叫队列。",
      "reference_cypher": "MATCH (q:消息队列) RETURN DISTINCT q.队列名称 AS 队列",
      "columns": [
        {
          "name": "队列",
          "aliases": [
            "queue",
            "队列名称",
            "消息队列"
          ]
        }
      ],
      "expected_rows": [
        {
          "队列": "lantern_opening"
        },
        {
          "队列": "lantern_audit"
        },
        {
          "队列": "lantern_orphan"
        }
      ]
    },
    {
      "id": "S05",
      "level": "简单",
      "question": "方法名恰好为 getDetails 的方法有几个？会出现同名方法，返回数量。",
      "reference_cypher": "MATCH (m:方法) WHERE m.方法名='getDetails' RETURN count(m) AS 数量",
      "columns": [
        {
          "name": "数量",
          "aliases": [
